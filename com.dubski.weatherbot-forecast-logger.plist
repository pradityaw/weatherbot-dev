<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dubski.weatherbot-forecast-logger</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/dubski/weatherbot &amp;&amp; source .venv/bin/activate &amp;&amp; python log_forecasts.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/dubski/weatherbot</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>2</integer>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/dubski/weatherbot/logs/forecast-logger.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/dubski/weatherbot/logs/forecast-logger.err.log</string>
</dict>
</plist>
