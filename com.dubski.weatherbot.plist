<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dubski.weatherbot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>/Users/dubski/weatherbot/launch-weatherbot.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/dubski/weatherbot</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/dubski/weatherbot/logs/weatherbot.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/dubski/weatherbot/logs/weatherbot.err.log</string>
</dict>
</plist>
