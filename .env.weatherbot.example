# Copy to .env.weatherbot and fill in secrets (never commit .env.weatherbot).
#
# Visual Crossing — required for self-learning (actual max temp after resolution):
#   https://www.visualcrossing.com/weather-api/
# Free tier is enough for this bot (one call per resolved market per city/date).
WEATHERBOT_VC_KEY=

# Optional overrides:
# WEATHERBOT_SCAN_INTERVAL=3600
# WEATHERBOT_MONITOR_INTERVAL=600

# Precipitation signal engine (logs data/precip_log.jsonl)
# WEATHERBOT_PRECIP_ENABLED=true
# WEATHERBOT_PRECIP_PAPER_ONLY=true   # Set false only to shadow through ExecutionGateway; live orders stay blocked for precip.
# WEATHERBOT_PRECIP_MAX_HOURS=2160      # horizon filter for monthly buckets (default max(72h, 2160))
# WEATHERBOT_PRECIP_DISCOVERY_PAGES=8   # Gamma weather-tag event pages (100 events/page)
# WEATHERBOT_PRECIP_SECONDARY_REQUIRED=true   # require Visual Crossing to agree with Open-Meteo
# WEATHERBOT_PRECIP_SECONDARY_MAX_DIFF_IN=0.10 # max realized precip source diff before blocking signal
# Precip uses explicit city proxies for NYC/Seattle/London/Seoul/Hong Kong and logs location_source.
