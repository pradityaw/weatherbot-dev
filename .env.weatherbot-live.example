# Live execution guardrails (default-safe)
WEATHERBOT_LIVE_TRADING=0
WEATHERBOT_DRY_RUN_LIVE=1
WEATHERBOT_MAX_LIVE_USDC=100
WEATHERBOT_LIVE_TRADE_CAP_USDC=2
WEATHERBOT_MAX_OPEN_EXPOSURE_USDC=25
WEATHERBOT_MAX_DAILY_LOSS_USDC=15
WEATHERBOT_MAX_NEW_TRADES_PER_DAY=5
WEATHERBOT_LIVE_MAX_PRICE=0.45
WEATHERBOT_LIVE_MAX_SLIPPAGE=0.03
WEATHERBOT_LIVE_MIN_TOP_ASK_SIZE=1.0
WEATHERBOT_KILL_SWITCH_FILE=data/pause_live

# Trader-edge shadow logging (optional). Requires offline rankings from trader_research pipeline.
# WEATHERBOT_TRADER_EDGE=0
# WEATHERBOT_TRADER_EDGE_TOP_N=15
# WEATHERBOT_TRADER_RANKINGS=data/trader_research/processed/rankings.json
# WEATHERBOT_TRADER_EDGE_STRENGTH=0

# Optional webhook for entry/exit alerts.
# WEATHERBOT_ALERT_WEBHOOK_URL=

# Polymarket credentials (required only when WEATHERBOT_LIVE_TRADING=1 and DRY_RUN=0).
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_FUNDER_ADDRESS=
POLYGON_RPC_URL=
